(footprint "MEMS_LMA2718"
	(version 20240108)
	(generator "hand")
	(layer "F.Cu")
	(descr "LinkMems LMA2718B381-OA7 (C5373222), analog bottom-port MEMS mic, SMD-4P 2.8x1.9mm. Land pattern per LinkMems LMA2718B381 datasheet section 7.1: pads 1=OUT 2=GND 3=VDD, 0.35/0.30/0.35 x 0.55mm, 0.625mm pitch (1.60 span); pad4=GND annular ring OD1.45/ID0.95; acoustic port (NPTH) Ø0.35 at ring centre (enlarged from datasheet Ø0.25 for manufacturability; still 0.30mm clear of the ring ID); 1.20mm from the pads' inner edge to the ring centre (datasheet 6.2: 0.55 + 1.20 + 0.875 of the 2.75 length), so 1.475 centre to centre; origin at the package centre: pads at y -0.975, ring and port at +0.500. No GND bridge (datasheet-faithful) - tie pad2 to pad4/pour on the board.")
	(tags "microphone MEMS analog LMA2718")
	(attr smd)
	(pad "3" smd rect (at -0.625 -0.975) (size 0.35 0.55) (layers "F.Cu" "F.Paste" "F.Mask"))
	(pad "2" smd rect (at 0.00 -0.975) (size 0.30 0.55) (layers "F.Cu" "F.Paste" "F.Mask"))
	(pad "1" smd rect (at 0.625 -0.975) (size 0.35 0.55) (layers "F.Cu" "F.Paste" "F.Mask"))
	(pad "4" smd custom (at 0.00 -0.10) (size 0.15 0.15) (layers "F.Cu" "F.Paste" "F.Mask")
		(clearance 0.1)
		(options (clearance outline) (anchor circle))
		(primitives
			(gr_circle (center 0 0.60) (end 0.60 0.60) (width 0.25) (fill no))
		)
	)
	(pad "" np_thru_hole circle (at 0.00 0.50) (size 0.35 0.35) (drill 0.35) (layers "F.Cu"))
	(fp_rect (start -1.025 -1.475) (end 1.025 1.475) (stroke (width 0.1) (type solid)) (layer "F.SilkS"))
	(fp_text reference "REF**" (at 0 -2.0) (layer "F.SilkS") (effects (font (size 0.8 0.8) (thickness 0.12))))
	(fp_text value "MEMS_LMA2718" (at 0 2.0) (layer "F.Fab") (effects (font (size 0.6 0.6) (thickness 0.1))))
	(model "phone_cad_2_parts.3dshapes/MEMS_LMA2718.wrl"
		(offset (xyz 0 0 0)) (scale (xyz 1 1 1)) (rotate (xyz 0 0 0)))
